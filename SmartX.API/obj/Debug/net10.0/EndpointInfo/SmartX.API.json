{
  "openapi": "3.0.4",
  "info": {
    "title": "SmartX.API",
    "version": "1.0"
  },
  "paths": {
    "/api/sensors": {
      "post": {
        "tags": [
          "SmartX.API"
        ],
        "operationId": "RegisterSensor",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Sensor"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "get": {
        "tags": [
          "SmartX.API"
        ],
        "operationId": "GetSensors",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/telemetry": {
      "post": {
        "tags": [
          "SmartX.API"
        ],
        "operationId": "IngestTelemetry",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TelemetryRecord"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "get": {
        "tags": [
          "SmartX.API"
        ],
        "operationId": "GetTelemetry",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/telemetry/{mac}": {
      "get": {
        "tags": [
          "SmartX.API"
        ],
        "operationId": "GetTelemetryByMac",
        "parameters": [
          {
            "name": "mac",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/telemetry/batch": {
      "post": {
        "tags": [
          "SmartX.API"
        ],
        "operationId": "IngestTelemetryBatch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TelemetryBatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/sensors/{mac}/validate": {
      "get": {
        "tags": [
          "SmartX.API"
        ],
        "operationId": "ValidateSensorNode",
        "parameters": [
          {
            "name": "mac",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/sensors/{mac}/attachments": {
      "post": {
        "tags": [
          "SmartX.API"
        ],
        "operationId": "UploadAttachment",
        "parameters": [
          {
            "name": "mac",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "file"
                ],
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              },
              "encoding": {
                "file": {
                  "style": "form"
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "get": {
        "tags": [
          "SmartX.API"
        ],
        "operationId": "GetAttachments",
        "parameters": [
          {
            "name": "mac",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/telemetry/thresholds": {
      "get": {
        "tags": [
          "SmartX.API"
        ],
        "operationId": "GetThresholds",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Sensor": {
        "type": "object",
        "properties": {
          "macAddress": {
            "type": "string",
            "nullable": true
          },
          "room": {
            "type": "string",
            "nullable": true
          },
          "zone": {
            "type": "string",
            "nullable": true
          },
          "nodeId": {
            "type": "string",
            "nullable": true
          },
          "category": {
            "$ref": "#/components/schemas/SensorCategory"
          },
          "registeredAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "SensorCategory": {
        "enum": [
          "Environmental",
          "PowerConsumption",
          "Actuator"
        ],
        "type": "string"
      },
      "TelemetryBatchRequest": {
        "type": "object",
        "properties": {
          "deviceIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "batches": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              }
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "TelemetryRecord": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "nullable": true
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "packetType": {
            "type": "string",
            "nullable": true
          },
          "dataValue": {
            "type": "string",
            "nullable": true
          },
          "severity": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}