  "components": {
    "schemas": {
      "CommandRequest": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "nullable": true
          },
          "type": {
            "$ref": "#/components/schemas/CommandType"
          },
          "issuedBy": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CommandType": {
        "enum": [
          "PumpOn",
          "PumpOff",
          "RelayOn",
          "RelayOff",
          "ValveOpen",
          "ValveClose"
        ],
        "type": "string"
      },
      "SearchActivityRequest": {
        "type": "object",
        "properties": {
          "term": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SeedHistoryRequest": {
        "type": "object",
        "properties": {
          "alertDeviceId": {
            "type": "string",
            "nullable": true
          },
          "commandDeviceId": {
            "type": "string",
            "nullable": true
          },
          "command": {
            "$ref": "#/components/schemas/CommandType"
          },
          "searchTerm": {
            "type": "string",
            "nullable": true
          },
          "repetitions": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "Sensor": {
        "type": "object",
        "properties": {
          "macAddress": {
            "type": "string",
            "nullable": true
          },
          "room": {
            "type": "string",
            "nullable": true
          },
          "zone": {
            "type": "string",
            "nullable": true
          },
          "nodeId": {
            "type": "string",
            "nullable": true
          },
          "category": {
            "$ref": "#/components/schemas/SensorCategory"
          },
          "registeredAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "SensorCategory": {
        "enum": [
          "Environmental",
          "PowerConsumption",
          "Actuator"
        ],
        "type": "string"
      },
      "SimulateAlertRequest": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "nullable": true
          },
          "packetType": {
            "type": "string",
            "nullable": true
          },
          "value": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "TelemetryBatchRequest": {
        "type": "object",
        "properties": {
          "deviceIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "batches": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              }
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "TelemetryRecord": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "nullable": true
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "packetType": {
            "type": "string",
            "nullable": true
          },
          "dataValue": {
            "type": "string",
            "nullable": true
          },
          "severity": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
