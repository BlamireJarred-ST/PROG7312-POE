<Window x:Class="SmartX.Wpf.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartX - Login"
        Height="430" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Background="#F3F6FA">
        <Border Background="White"
                CornerRadius="12"
                Padding="30"
                Margin="25">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="SmartX"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#2D6CDF"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Sign in to your account"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <TextBlock Text="Email address" Margin="0,0,0,5"/>
                <TextBox x:Name="EmailInput"
                         Height="36"
                         Padding="8"
                         Margin="0,0,0,15"/>

                <TextBlock Text="Password" Margin="0,0,0,5"/>
                <PasswordBox x:Name="PasswordInput"
                             Height="36"
                             Padding="8"
                             Margin="0,0,0,20"/>

                <Button x:Name="LoginButton"
                        Content="Sign in"
                        Height="42"
                        Background="#2D6CDF"
                        Foreground="White"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Click="LoginButton_Click"/>

                <TextBlock x:Name="StatusText"
                           TextWrapping="Wrap"
                           Foreground="Firebrick"
                           Margin="0,12,0,0"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
