<Window x:Class="SmartX.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartX.Wpf"
        mc:Ignorable="d"
        Title="SmartX — IoT Mesh Ecosystem"
        Height="820" Width="1340"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Navigation menu item-->
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" Padding="20,14">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A4A63"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D6CDF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- Left navigation menu -->
        <Border DockPanel.Dock="Left" Width="270" Background="#1F2A3C">
            <DockPanel>

                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,20">
                    <TextBlock Text="SmartX" FontSize="30" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="IoT Mesh Ecosystem" FontSize="12" Foreground="#9FB0C9"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="20,12">
                    <TextBlock x:Name="ApiStatusText"
                               Text="● Checking API..."
                               Foreground="#9FB0C9"
                               FontSize="12"/>
                </StackPanel>

                <StackPanel>
                    <RadioButton x:Name="SensorsNav"
                                 Style="{StaticResource NavButton}"
                                 GroupName="Modules"
                                 Tag="Sensors"
                                 Content="Sensor Data Ingestion and Telemetry"
                                 Checked="Nav_Checked"/>

                    <RadioButton x:Name="CommandsNav"
                                 Style="{StaticResource NavButton}"
                                 GroupName="Modules"
                                 Tag="Commands"
                                 Content="Real-Time Command Stream and History"
                                 Checked="Nav_Checked"/>

                    <RadioButton x:Name="TopologyNav"
                                 Style="{StaticResource NavButton}"
                                 GroupName="Modules"
                                 Tag="Topology"
                                 Content="Network Topology and Mesh Routing"
                                 Checked="Nav_Checked"/>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- views are swapped here but never destroyed -->
        <ContentControl x:Name="ContentHost" Background="White"/>

    </DockPanel>
</Window>
